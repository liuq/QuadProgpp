#ifndef QUADPROG_CONFIG_H
#define QUADPROG_CONFIG_H

#define QUADPROGPP_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define QUADPROGPP_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define QUADPROGPP_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define QUADPROGPP_VERSION "@PROJECT_VERSION@"

// Determine which backend is active
#if defined(QUADPROGPP_USE_EIGEN)
    #define QUADPROGPP_MATRIX_BACKEND_EIGEN
#elif defined(QUADPROGPP_USE_ARMADILLO)
    #define QUADPROGPP_MATRIX_BACKEND_ARMADILLO
#else
    #define QUADPROGPP_MATRIX_BACKEND_BUILTIN
#endif

#if defined(QUADPROGPP_USE_SPDLOG)
    #define QUADPROGPP_ENABLE_LOGGING
#endif

#endif // QUADPROG_CONFIG_H
